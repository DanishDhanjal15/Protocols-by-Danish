# Copy to .env.local (local) and add the same values in Vercel → Settings → Environment Variables.
# Until all four of the first four are set, the site runs without a login wall.

# Postgres connection string
#   local:  postgres://postgres:<your-password>@localhost:5432/protocols
#   Vercel: the connection string from Neon / Vercel Postgres (keep ?sslmode=require)
DATABASE_URL=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A long random string that signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional: the site's public address, used to build the Google redirect URI.
# Leave empty locally. On Vercel set it to https://protocols-by-danish.vercel.app
APP_URL=
